ANTHROPIC_API_KEY=
# Jev runs through OpenRouter: use an OpenRouter key here
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=typesafe/jev-1.14
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
RELAY_TOKEN=pick-a-long-random-string
DEFAULT_DEVICE=phone

# Unlock the emulator by voice: say the passphrase before your request
# ("open sesame, open Spotify"). Relay types the PIN itself; the AI never sees it.
EMULATOR_PIN=
RELAY_PASSPHRASE=
CLAUDE_FAST_MODEL=claude-haiku-5-5

# X accounts for "what happened overnight" (DeItaone = Walter Bloomberg)
NEWS_ACCOUNTS=DeItaone

# Cloud mode (optional, off by default). See deploy/VULTR.md.
# On the cloud server: CLOUD_MODE=1.  On the Mac: RELAY_SERVER=https://1-2-3-4.sslip.io
# (then run: python -m relay.device_helper). RELAY_TOKEN must be the same on both.
CLOUD_MODE=
RELAY_SERVER=
REMOTE_TIMEOUT=30

# X refuses app logins on some emulators: 1 = read x.com in Chrome instead
X_IN_BROWSER=0
