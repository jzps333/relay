# Caddy: free automatic HTTPS (Let's Encrypt) in front of Relay.
# Replace 1-2-3-4.sslip.io with YOUR server's IP written with dashes
# (IP 45.76.10.20 -> 45-76-10-20.sslip.io). sslip.io turns that name back into
# the IP for free, so you don't need to buy a domain.
#
# Install:  sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

1-2-3-4.sslip.io {
	# Everything (the Shortcut's /command, /reply, /audio, the dashboard, AND the
	# Mac helper's websocket /device/ws) goes to Relay on this server.
	# reverse_proxy handles websocket upgrades by itself.
	reverse_proxy localhost:8000 {
		# Send the dashboard's live event stream right away instead of buffering it.
		flush_interval -1
	}
}
